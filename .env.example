# da-platform — environment variable NAMES only. Never commit real values.
# Production: app secrets in /var/www/da-platform/shared/.env.production (symlinked
# into each release); DA-CRM secrets in /var/www/da-platform/.env.local, loaded by
# explicit path (lib/crm/env.ts for the app, scripts/crm-env.ts for scripts).
# This file lists only the variables added for DA-CRM; see CLAUDE-da-platform.md
# for the rest.

# ── DA-CRM · Dialpad (Phase 1) ───────────────────────────────────────────────
DIALPAD_API_KEY=            # company API key (Dialpad Admin → Integrations → API keys)
DIALPAD_WEBHOOK_SECRET=     # shared secret the Dialpad webhook is created with (HS256 JWT bodies)
DIALPAD_COMPANY_ID=         # sanity check: scripts/crm-dialpad-setup.ts --check
# DIALPAD_API_BASE=https://sandbox.dialpad.com   # optional: sandbox instead of dialpad.com
# CRM_COPY_RECORDINGS=0                           # optional: don't copy recordings to S3

# ── DA-CRM · da-billing integration ──────────────────────────────────────────
CRM_WEBHOOK_SECRET=         # signs outbound webhooks (X-DA-CRM-Signature); share with da-billing
CRM_EVENTS_TOKEN=           # bearer token da-billing uses for POST /api/crm/events

# ── DA-CRM · Microsoft 365 (Phase 2 Inbox — not used yet) ────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_GRAPH_WEBHOOK_SECRET=    # random 64 hex; Graph echoes it as clientState (Inbox webhook)
# CRM_PUBLIC_BASE_URL=https://app.dealeraddendums.com   # optional: host for the Graph webhook URL

# Optional: point the DA-CRM loader at a different secrets file.
# CRM_ENV_FILE=/path/to/.env.local
