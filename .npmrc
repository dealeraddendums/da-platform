# Fail loudly on a Node version mismatch instead of building anyway.
# Production runs Node 20 (system node, /usr/bin/node, v20.20.2 as of 2026-09-03) and there is
# NO staging environment, so a local build on a different major is an untested build.
# With engine-strict, `npm install` / `npm ci` ERROR instead of printing a warning nobody reads.
# Run `nvm use` (reads .nvmrc) to switch.
engine-strict=true
